# ============================================================
# DTRANS RENTAL — Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# App
APP_NAME="Dtrans Rental"
APP_URL=http://localhost/dtrans-rental/public
APP_ENV=local
APP_DEBUG=true
APP_KEY=your_random_32_char_secret_key_here

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dtrans_rental
DB_USER=root
DB_PASS=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/dtrans-rental/public/auth/google/callback

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME="Dtrans Rental"
MAIL_FROM_ADDRESS=your_email@gmail.com

# Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_ENV=sandbox

# Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
