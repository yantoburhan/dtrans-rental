{
    "name": "dtrans/rental",
    "description": "Dtrans Rental — Car Rental & Tourism Platform, North Sumatra",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.8",
        "league/oauth2-google": "^3.0",
        "dompdf/dompdf": "^2.0",
        "endroid/qr-code": "^4.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"copy('.env', '.env') || copy('.env', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true
    }
}
